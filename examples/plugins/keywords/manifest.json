{
  "api_version": 1,
  "id": "keywords",
  "name": "Keyword replies",
  "version": "1.0.0",
  "entry": "dist/index.js",
  "runtime": "javascript",
  "permissions": [
    "events.subscribe",
    "message.send",
    "config.read"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "default": "hello"
      },
      "reply": {
        "type": "string",
        "default": "Hello!"
      }
    }
  }
}
