{
  "api_version": 1,
  "id": "counter",
  "name": "Persistent counter",
  "version": "1.0.0",
  "entry": "dist/index.js",
  "runtime": "javascript",
  "permissions": [
    "commands.register",
    "message.send",
    "config.read",
    "state.read",
    "state.write"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "default": "Count"
      }
    }
  }
}
